# App Environment
NODE_ENV=local
PORT=3000
APP_URL=http://localhost:3000

# Database (MySQL)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & API Secrets
PASSPHRASE=test
SIGNER_KEY=your_signer_key_here
ROOT_ADMIN_API_SECRET=your_admin_secret_here

# Executor Configuration
EXECUTOR_ENDPOINT=https://mm-hcm.the20.sg/api
EXECUTOR_USERNAME=executor_user
EXECUTOR_SECRET=executor_secret
EXECUTOR_PASSPHRASE=executor_passphrase

# Web3 RPC Endpoints
BERA_RPC=https://rpc.berachain.com/
A8_RPC=https://rpc.ancient8.gg
METIS_RPC=https://andromeda.metis.io/?owner=1088
ZKSYNC_RPC=https://mainnet.era.zksync.io
ARB_RPC=https://arb1.arbitrum.io/rpc

# TRON Network
TRON_BASE_URL=https://api.trongrid.io
TRON_DEFAULT_PRIVATE_KEY=
NETWORK=mainnet
MAINNET_RPC=https://rpc.ancient8.gg
TESTNET_RPC=https://rpcv2-testnet.ancient8.gg/