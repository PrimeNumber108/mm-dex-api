# App Environment (Production)
NODE_ENV=production
PORT=3000
APP_URL=https://mm.the20.sg

# Database (MySQL)
MYSQL_HOST=prod-db-host
MYSQL_USER=prod_user
MYSQL_PASSWORD=prod_password

# Redis
REDIS_HOST=prod-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=prod_redis_password

# Security & API Secrets
PASSPHRASE=prod_passphrase_secret
SIGNER_KEY=prod_signer_key
ROOT_ADMIN_API_SECRET=prod_admin_secret

# Executor Configuration
EXECUTOR_ENDPOINT=https://mm.the20.sg/api
EXECUTOR_USERNAME=prod_executor_user
EXECUTOR_SECRET=prod_executor_secret
EXECUTOR_PASSPHRASE=prod_executor_passphrase

# Web3 RPC Endpoints
BERA_RPC=https://rpc.berachain.com/
A8_RPC=https://rpc.ancient8.gg
METIS_RPC=https://andromeda.metis.io/?owner=1088
ZKSYNC_RPC=https://mainnet.era.zksync.io
ARB_RPC=https://arb1.arbitrum.io/rpc

# TRON Network
TRON_BASE_URL=https://api.trongrid.io
TRON_DEFAULT_PRIVATE_KEY=prod_tron_private_key
NETWORK=mainnet
MAINNET_RPC=https://rpc.ancient8.gg
TESTNET_RPC=https://rpcv2-testnet.ancient8.gg/
