# App Environment (Staging)
NODE_ENV=staging
PORT=3000
APP_URL=https://mm-hcm.the20.sg/dex/

# Database (MySQL)
MYSQL_HOST=staging-db-host
MYSQL_USER=staging_user
MYSQL_PASSWORD=staging_password

# Redis
REDIS_HOST=staging-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password

# Security & API Secrets
PASSPHRASE=staging_passphrase_secret
SIGNER_KEY=staging_signer_key
ROOT_ADMIN_API_SECRET=staging_admin_secret

# Executor Configuration
EXECUTOR_ENDPOINT=https://mm-hcm.the20.sg/api
EXECUTOR_USERNAME=staging_executor_user
EXECUTOR_SECRET=staging_executor_secret
EXECUTOR_PASSPHRASE=staging_executor_passphrase

# Web3 RPC Endpoints
BERA_RPC=https://rpc.berachain.com/
A8_RPC=https://rpc.ancient8.gg
METIS_RPC=https://andromeda.metis.io/?owner=1088
ZKSYNC_RPC=https://mainnet.era.zksync.io
ARB_RPC=https://arb1.arbitrum.io/rpc

# TRON Network
TRON_BASE_URL=https://api.trongrid.io
TRON_DEFAULT_PRIVATE_KEY=staging_tron_private_key
NETWORK=mainnet
MAINNET_RPC=https://rpc.ancient8.gg
TESTNET_RPC=https://rpcv2-testnet.ancient8.gg/
